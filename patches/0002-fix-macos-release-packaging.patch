index 0000000..fecff90
--- /dev/null
+++ b/tests/macos_package_smoke_test.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Exercise final ZIP extraction through the packaged --version smoke."""
+
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import tempfile
+import unittest
+import zipfile
+
+
+@unittest.skipUnless(sys.platform == "darwin", "requires native macOS ditto")
+class MacOSPackageSmokeTest(unittest.TestCase):
+    def run_smoke(self, artifact: Path) -> subprocess.CompletedProcess:
+        script = Path(__file__).resolve().parents[1] / "scripts" / "smoke_package.py"
+        return subprocess.run(
+            [sys.executable, str(script), "--artifact", str(artifact), "--version", "9.8.7"],
+            text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
+        )
+
+    def test_zip_preserves_executable_and_framework_link(self) -> None:
+        with tempfile.TemporaryDirectory() as temp:
+            artifact = Path(temp) / "application.app.zip"
+            with zipfile.ZipFile(artifact, "w") as archive:
+                executable = zipfile.ZipInfo("rclone-browser.app/Contents/MacOS/rclone-browser")
+                executable.create_system = 3
+                executable.external_attr = (stat.S_IFREG | 0o755) << 16
+                archive.writestr(executable, '#!/bin/sh\ncat "../Frameworks/Test.framework/Versions/Current/version"\n')
+                link = zipfile.ZipInfo("rclone-browser.app/Contents/Frameworks/Test.framework/Versions/Current")
+                link.create_system = 3
+                link.external_attr = (stat.S_IFLNK | 0o777) << 16
+                archive.writestr(link, "A")
+                archive.writestr("rclone-browser.app/Contents/Frameworks/Test.framework/Versions/A/version", "Rclone Browser NG 9.8.7\n")
+            result = self.run_smoke(artifact)
+            self.assertEqual(result.returncode, 0, result.stdout)
+
+    def test_rejects_archive_traversal_before_extraction(self) -> None:
+        with tempfile.TemporaryDirectory() as temp:
+            artifact = Path(temp) / "unsafe.app.zip"
+            for name, payload, mode in [
+                ("../outside", "escaped", stat.S_IFREG | 0o644),
+                ("rclone-browser.app/Contents/Frameworks/link", "../../../../outside", stat.S_IFLNK | 0o777),
+                ("rclone-browser.app/Contents/Frameworks/link", "//tmp/outside", stat.S_IFLNK | 0o777),
+            ]:
+                with self.subTest(name=name):
+                    with zipfile.ZipFile(artifact, "w") as archive:
+                        member = zipfile.ZipInfo(name)
+                        member.create_system = 3
+                        member.external_attr = mode << 16
+                        archive.writestr(member, payload)
+                    result = self.run_smoke(artifact)
+                    self.assertNotEqual(result.returncode, 0)
+                    self.assertIn("unsafe path", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
