diff --git a/scripts/smoke_package.py b/scripts/smoke_package.py
index 363fc3d..1261fe4 100644
--- a/scripts/smoke_package.py
+++ b/scripts/smoke_package.py
@@ -4,10 +4,12 @@
 from __future__ import annotations
 
 import argparse
+from collections import deque
 from contextlib import contextmanager
 import os
-from pathlib import Path
+from pathlib import Path, PurePosixPath
 import shutil
+import stat
 import subprocess
 import sys
 import tempfile
@@ -17,10 +19,58 @@ import zipfile
 def safe_extract(archive: Path, destination: Path) -> None:
     destination_root = destination.resolve()
     with zipfile.ZipFile(archive) as source:
+        links = {}
         for member in source.infolist():
             target = (destination / member.filename).resolve()
             if target != destination_root and destination_root not in target.parents:
                 raise ValueError(f"archive contains an unsafe path: {member.filename}")
+            if sys.platform == "darwin" and stat.S_ISLNK(member.external_attr >> 16):
+                key = target.relative_to(destination_root).parts
+                if key in links:
+                    raise ValueError(f"archive contains duplicate symlink: {member.filename}")
+                links[key] = source.read(member).decode("utf-8")
+
+        if sys.platform == "darwin":
+            # Resolve archive links before ditto can write through any of them.
+            def resolve_member(name: str) -> None:
+                pending = deque(PurePosixPath(name).parts)
+                resolved = []
+                followed = 0
+                while pending:
+                    part = pending.popleft()
+                    if part == "/" or "\x00" in part:
+                        raise ValueError(f"archive contains an unsafe path: {name}")
+                    if part == "..":
+                        if not resolved:
+                            raise ValueError(f"archive contains an unsafe path: {name}")
+                        resolved.pop()
+                    elif part != ".":
+                        resolved.append(part)
+                        link = links.get(tuple(resolved))
+                        if link is not None:
+                            followed += 1
+                            if followed > 40:
+                                raise ValueError(f"archive contains cyclic links: {name}")
+                            resolved.pop()
+                            link_target = PurePosixPath(link)
+                            if link_target.is_absolute():
+                                raise ValueError(f"archive contains an unsafe path: {name}")
+                            pending.extendleft(reversed(link_target.parts))
+
+            for member in source.infolist():
+                parts = PurePosixPath(member.filename).parts
+                if ".." in parts or any(parts[:index] in links for index in range(1, len(parts))):
+                    raise ValueError(f"archive contains an unsafe path: {member.filename}")
+                resolve_member(member.filename)
+            destination.mkdir(parents=True, exist_ok=True)
+            subprocess.run(
+                ["/usr/bin/ditto", "-x", "-k", str(archive), str(destination)],
+                check=True,
+            )
+            return
+
+        for member in source.infolist():
+            target = (destination / member.filename).resolve()
             if member.is_dir():
                 target.mkdir(parents=True, exist_ok=True)
                 continue
diff --git a/tests/macos_package_smoke_test.py b/tests/macos_package_smoke_test.py
