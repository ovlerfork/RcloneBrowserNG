From add98628bc0aacc8de77c83f6759523109f4125d Mon Sep 17 00:00:00 2001
From: Ovler <44089074+Ovler-Young@users.noreply.github.com>
Date: Tue, 13 Oct 2026 04:20:03 +0000
Subject: [PATCH 1/3] Fix portable platform build flags

---
 src/CMakeLists.txt | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 080b3fb..3dc7c2e 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -14,13 +14,22 @@ else()
   set(CMAKE_CXX_STANDARD 17)
   set(CMAKE_CXX_STANDARD_REQUIRED ON)
   add_definitions("-pedantic -Wall -Wextra -Werror -Wno-deprecated-declarations")
-  add_compile_options(-fstack-protector-strong -fcf-protection=full)
+  add_compile_options(-fstack-protector-strong)
+  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i.86)$")
+    include(CheckCXXCompilerFlag)
+    check_cxx_compiler_flag("-fcf-protection=full" HAVE_CFI_PROTECTION)
+    if(HAVE_CFI_PROTECTION)
+      add_compile_options(-fcf-protection=full)
+    endif()
+  endif()
   add_definitions(-D_FORTIFY_SOURCE=3)
   set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-  add_link_options(-Wl,-z,relro,-z,now)
+  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    add_link_options(-Wl,-z,relro,-z,now)
+  endif()
 endif()
 
-if (APPLE)
+if (APPLE AND NOT CMAKE_OSX_DEPLOYMENT_TARGET)
   set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0)
 endif()
 
