diff --git a/tests/app_log_test.cpp b/tests/app_log_test.cpp
index ddc8e12..89f4272 100644
--- a/tests/app_log_test.cpp
+++ b/tests/app_log_test.cpp
@@ -38,9 +38,16 @@ private slots:
   }
 
   void init() {
-    // Each case starts from an empty log directory.
-    QDir(AppLog::LogDirectory()).removeRecursively();
-    QDir().mkpath(AppLog::LogDirectory());
+    // Keep the live log file in place while the logger's handle is open.
+    AppLog::Flush();
+    const QString base = AppLog::LogFilePath();
+    QFile file(base);
+    QVERIFY(file.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    file.close();
+    for (int i = 1; i <= AppLog::Generations(); ++i) {
+      QFile::remove(QString("%1.%2").arg(base).arg(i));
+    }
+    AppLog::SetLevel(AppLog::Level::Info);
   }
 
